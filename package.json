{
	"name": "floating-twitch-chat",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "Chrome extension that overlays Twitch chat on the fullscreen video player.",
	"scripts": {
		"build": "webpack --mode production",
		"dev": "webpack --mode development",
		"watch": "webpack --mode development --watch",
		"test": "node --test \"tests/*.test.js\"",
		"test:live": "node --test --test-timeout=120000 \"tests/*.live.js\""
	},
	"dependencies": {
		"framer-motion": "^3.10.6",
		"react": "^16.14.0",
		"react-dom": "^16.14.0",
		"tmi.js": "^1.8.5"
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@babel/preset-env": "^7.24.0",
		"@babel/preset-react": "^7.23.3",
		"@simonwep/pickr": "^1.10.0",
		"babel-loader": "^9.1.3",
		"copy-webpack-plugin": "^12.0.2",
		"water.css": "^2.1.1",
		"webpack": "^5.90.3",
		"webpack-cli": "^5.1.4"
	},
	"babel": {
		"presets": [
			[
				"@babel/preset-env",
				{
					"targets": {
						"chrome": "88"
					}
				}
			],
			[
				"@babel/preset-react",
				{
					"runtime": "automatic"
				}
			]
		]
	}
}
