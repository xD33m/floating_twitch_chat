{
	"manifest_version": 3,
	"short_name": "Floating Twitch Chat",
	"name": "Floating Twitch Chat",
	"description": "Overlays Twitch chat on top of the fullscreen video player.",
	"version": "2.0",
	"minimum_chrome_version": "88",
	"icons": {
		"16": "assets/icon16.png",
		"32": "assets/icon32.png",
		"48": "assets/icon48.png",
		"128": "assets/icon128.png"
	},
	"permissions": ["storage"],
	"background": {
		"service_worker": "app/background.js"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Floating Twitch Chat (the overlay shows in fullscreen)",
		"default_icon": {
			"16": "assets/icon16.png",
			"32": "assets/icon32.png",
			"48": "assets/icon48.png"
		}
	},
	"content_scripts": [
		{
			"matches": ["*://*.twitch.tv/*"],
			"css": ["css/root.css"],
			"js": ["static/js/content.js"],
			"run_at": "document_idle"
		}
	]
}
